{
  "name": "atom-uikit-ds",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "validate": "node scripts/validate-tokens.js",
    "validate:contrast": "node scripts/check-contrast.mjs",
    "validate:published": "node scripts/validate-published-tokens.mjs",
    "conformance": "node scripts/conformance.mjs",
    "validate:embed": "node packages/css/scripts/validate-embed-scope.mjs",
    "test:embed-leak": "node packages/css/scripts/test-embed-leak.mjs",
    "build:registry": "pnpm --filter @atom-uikit/tokens build && node scripts/build-registry.mjs",
    "release": "echo 'npm publishing DESHABILITADO — canales privados only (CLAUDE.md > Canales de distribucion)' && exit 1",
    "sync:webflow": "node scripts/sync-webflow.mjs",
    "test": "pnpm --filter @atom-uikit/components-react test",
    "test:components": "pnpm --filter @atom-uikit/components-react test",
    "test:visual": "pnpm --filter @atom-uikit/storybook test:visual"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "turbo": "^2.4.0"
  },
  "packageManager": "pnpm@10.0.0"
}
