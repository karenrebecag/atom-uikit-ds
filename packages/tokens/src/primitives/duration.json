{
  "duration": {
    "$type": "duration",
    "0": { "$value": "0ms", "$description": "Instant, no transition" },
    "75": { "$value": "75ms", "$description": "Micro-interactions: checkbox, toggle" },
    "100": { "$value": "100ms", "$description": "Fast feedback: button press, focus ring" },
    "150": { "$value": "150ms", "$description": "Quick transitions: hover states, tooltips" },
    "200": { "$value": "200ms", "$description": "Default transition: most UI interactions" },
    "300": { "$value": "300ms", "$description": "Medium transitions: dropdowns, panels" },
    "500": { "$value": "500ms", "$description": "Slow transitions: modals, page elements" },
    "600": { "$value": "600ms", "$description": "ATOM duration-default — el paso base de su escala de motion (0.15/0.3/0.6/0.9/1.2s); con easing-osmo es el smoothness firma" },
    "700": { "$value": "700ms", "$description": "Entrance animations: hero, stagger" },
    "900": { "$value": "900ms", "$description": "ATOM duration-onehalf — transiciones largas de layout (ej. el shrink de su navbar)" },
    "1000": { "$value": "1000ms", "$description": "Long animations: skeleton shimmer, loaders" },
    "1200": { "$value": "1200ms", "$description": "ATOM duration-l — long motion (W6)" },
    "1800": { "$value": "1800ms", "$description": "ATOM duration-xl — extended motion (W6)" }
  },
  "easing": {
    "$type": "cubicBezier",
    "linear": { "$value": "linear", "$description": "Constant speed, progress bars" },
    "in": { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$description": "Accelerate — elements exiting view" },
    "out": { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$description": "ATOM expo-out — elements entering view" },
    "in-out": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$description": "Default — most transitions" },
    "spring": { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$description": "Bouncy overshoot — playful interactions" },
    "osmo": { "$value": "cubic-bezier(0.625, 0.05, 0, 1)", "$description": "ATOM signature ease" }
  }
}
