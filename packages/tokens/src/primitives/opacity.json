    "10": { "$value": 0.10, "$description": "Disabled backgrounds, faint tints" },
    "20": { "$value": 0.20, "$description": "Hover overlays, subtle highlights" },
    "30": { "$value": 0.30, "$description": "Backdrop light, soft overlays" },
    "50": { "$value": 0.50, "$description": "Backdrop medium, placeholder text" },
    "70": { "$value": 0.70, "$description": "Backdrop heavy, dimmed content" },
    "80": { "$value": 0.80, "$description": "Modal overlay, focus backdrop" },
    "90": { "$value": 0.90, "$description": "Near-opaque layers, frosted glass" }
  }
}
