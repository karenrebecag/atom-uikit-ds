{
  "font-family": {
    "$type": "fontFamilies",
    "sans": { "$value": "Inter" },
    "mono": { "$value": "JetBrains Mono" }
  },
  "font-weight": {
    "$type": "fontWeights",
    "regular": { "$value": "400" },
    "medium": { "$value": "500" },
    "semibold": { "$value": "600" },
    "bold": { "$value": "700" }
  },
  "font-size": {
    "$type": "dimension",
    "xs": { "$value": "10px" },
    "sm": { "$value": "13px" },
    "base": { "$value": "16px" },
    "lg": { "$value": "20px" },
    "xl": { "$value": "25px" },
    "2xl": { "$value": "31px" },
    "3xl": { "$value": "39px" },
    "4xl": { "$value": "49px" },
    "5xl": { "$value": "61px" },
    "6xl": { "$value": "76px" }
  },
  "line-height": {
    "$type": "dimension",
    "xs": { "$value": "16px" },
    "sm": { "$value": "20px" },
    "base": { "$value": "24px" },
    "lg": { "$value": "28px" },
    "xl": { "$value": "34px" },
    "2xl": { "$value": "40px" },
    "3xl": { "$value": "48px" },
    "4xl": { "$value": "57px" },
    "5xl": { "$value": "68px" },
    "6xl": { "$value": "82px" }
  },
  "letter-spacing": {
    "$type": "dimension",
    "tight": { "$value": "-0.02em" },
    "normal": { "$value": "0em" },
    "wide": { "$value": "0.04em" }
  }
}
