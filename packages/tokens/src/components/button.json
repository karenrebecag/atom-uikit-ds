{
  "button": {
    "bg": {
      "$type": "color",
      "primary": { "$value": "{primary}", "$description": "Solid dark background" },
      "secondary": { "$value": "{background}", "$description": "White/transparent with border" },
      "tertiary": { "$value": "transparent", "$description": "Ghost — no background" },
      "destructive": { "$value": "{destructive}", "$description": "Danger solid" },
      "destructive-secondary": { "$value": "{background}", "$description": "Danger outlined" },
      "destructive-tertiary": { "$value": "transparent", "$description": "Danger ghost" }
    },
    "fg": {
      "$type": "color",
      "primary": { "$value": "{primary-foreground}", "$description": "Light text on dark bg" },
      "secondary": { "$value": "{foreground}", "$description": "Dark text on light bg" },
      "tertiary": { "$value": "{foreground}", "$description": "Dark text, no bg" },
      "destructive": { "$value": "{destructive-foreground}", "$description": "Light text on danger" },
      "destructive-secondary": { "$value": "{destructive}", "$description": "Red text on light bg" },
      "destructive-tertiary": { "$value": "{destructive}", "$description": "Red text, no bg" }
    },
    "border": {
      "$type": "color",
      "primary": { "$value": "transparent" },
      "secondary": { "$value": "{border}" },
      "tertiary": { "$value": "transparent" },
      "destructive": { "$value": "transparent" },
      "destructive-secondary": { "$value": "{destructive}" },
      "destructive-tertiary": { "$value": "transparent" }
    },
    "hover-bg": {
      "$type": "color",
      "primary": { "$value": "{color.zinc.800}" },
      "secondary": { "$value": "{accent}" },
      "tertiary": { "$value": "{accent}" },
      "destructive": { "$value": "{color.red.600}" },
      "destructive-secondary": { "$value": "{color.red.50}" },
      "destructive-tertiary": { "$value": "{color.red.50}" }
    },
    "pressed-bg": {
      "$type": "color",
      "primary": { "$value": "{color.zinc.900}" },
      "secondary": { "$value": "{color.zinc.100}" },
      "tertiary": { "$value": "{color.zinc.100}" },
      "destructive": { "$value": "{color.red.700}" },
      "destructive-secondary": { "$value": "{color.red.100}" },
      "destructive-tertiary": { "$value": "{color.red.100}" }
    },
    "disabled-fg": {
      "$type": "color",
      "all": { "$value": "{muted-foreground}", "$description": "Same for all disabled variants" }
    },
    "font-size": {
      "$type": "dimension",
      "xs": { "$value": "{font-size.xs}", "$description": "10px" },
      "s": { "$value": "{font-size.sm}", "$description": "13px" },
      "m": { "$value": "{font-size.base}", "$description": "16px" },
      "l": { "$value": "{font-size.lg}", "$description": "20px" },
      "xl": { "$value": "{font-size.xl}", "$description": "25px" }
    }
  }
}
