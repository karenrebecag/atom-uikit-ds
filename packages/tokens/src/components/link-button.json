{
  "link-button": {
    "fg": {
      "$type": "color",
      "enabled": { "$value": "{link}", "$description": "Link text — AA-safe sky per theme" },
      "hover": { "$value": "{foreground}", "$description": "Full contrast on hover" },
      "pressed": { "$value": "{primary}", "$description": "Stronger on press" },
      "disabled": { "$value": "{muted-foreground}", "$description": "Muted when disabled" }
    }
  }
}
