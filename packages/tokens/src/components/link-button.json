{
  "link-button": {
    "fg": {
      "$type": "color",
      "enabled": { "$value": "{color.blue.500}", "$description": "Blue link text" },
      "hover": { "$value": "{color.blue.600}", "$description": "Darker on hover" },
      "pressed": { "$value": "{color.blue.700}", "$description": "Darkest on press" },
      "disabled": { "$value": "{muted-foreground}", "$description": "Muted when disabled" }
    }
  }
}
