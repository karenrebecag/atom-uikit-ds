{
  "checkbox": {
    "bg": {
      "$type": "color",
      "unchecked": { "$value": "{background}", "$description": "Surface" },
      "unchecked-hover": { "$value": "{accent}", "$description": "Subtle highlight" },
      "checked": { "$value": "{primary}", "$description": "Dark fill" },
      "checked-hover": { "$value": "{primary-hover}", "$description": "Lighter on hover" },
      "disabled": { "$value": "{muted}", "$description": "Muted for all disabled" }
    },
    "fg": {
      "$type": "color",
      "checked": { "$value": "{primary-foreground}", "$description": "Check/minus icon on primary" },
      "disabled": { "$value": "{muted-foreground}", "$description": "Faded icon when disabled" }
    },
    "border": {
      "$type": "color",
      "default": { "$value": "{muted-foreground}", "$description": "Unchecked border" },
      "hover": { "$value": "{muted-foreground}", "$description": "Same on hover" },
      "disabled": { "$value": "{muted}", "$description": "Faded border" },
      "error": { "$value": "{destructive}", "$description": "Coral border on error" }
    },
    "focus-ring": {
      "$type": "color",
      "default": { "$value": "rgba(161, 161, 161, 0.7)", "$description": "Neutral alpha ring" }
    }
  }
}
