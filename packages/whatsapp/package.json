{
  "name": "@atom-uikit/whatsapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "[DEPRECATED — congelado 2026-07-22] Reemplazado por AtomGrowth/atom_whatsapp_buttons (loader evergreen en atom-whatsapp-buttons.vercel.app). Se conserva como referencia; no recibe cambios.",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./widget": "./dist/auto-init.iife.js",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "unpkg": "dist/auto-init.iife.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "build:tsc": "tsc --noEmit",
    "dev": "tsup --watch",
    "clean": "rm -rf dist/"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}
